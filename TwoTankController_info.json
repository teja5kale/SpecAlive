ep.HOLD2 and not pre(shutting);","when $whenCondition9 then\n    seq := Step.DRAIN;\n  end when;","$whenCondition10 := h2 <= h2Low and pre(seq) == Step.DRAIN and not pre(shutting);","when $whenCondition10 then\n    seq := Step.HOLD3;\n    tMark := tRun;\n  end when;","$whenCondition11 := tRun - tMark >= wait3 and pre(seq) == Step.HOLD3 and not pre(shutting);","when $whenCondition11 then\n    seq := Step.FILL;\n    tMark := tRun;\n  end when;","$whenCondition12 := pre(shutting) and h1 <= h1Low and h2 <= h2Low;","when $whenCondition12 then\n    shutting := false;\n    seq := Step.IDLE;\n  end when;"],"source":{"info":{"file":"","lineStart":0,"lineEnd":0,"colStart":0,"colEnd":0}}},
