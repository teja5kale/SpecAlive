    {"name": "SHUT", "kind": "event", "note": "controlled drain, NOT e-stop",
     "trace": ["06_design_review_minutes.md", "12_operator_shift_notes.txt"]}
  ],
  "states": ["IDLE", "FILL", "HOLD1", "TRANSFER", "HOLD2", "DRAIN", "HOLD3", "SHUTTING", "PAUSED"],
  "transitions": [
    {"from": "IDLE", "to": "FILL", "guard": "START and not paused", "trace": ["D-07"]},
    {"from": "FILL", "to": "HOLD1", "guard": "h1 >= h1High"},
    {"from": "HOLD1", "to": "TRANSFER", "guard": "elapsed >= wait1"},
    {"from": "TRANSFER", "to": "HOLD2", "guard": "h1 <= h1Low"},
    {"from": "HOLD2", "to": "DRAIN", "guard": "elapsed >= wait2 (12 s, CR-004)"},
    {"from": "DRAIN", "to": "HOLD3", "guard": "h2 <= h2Low"},
    {"from": "HOLD3", "to": "FILL", "guard": "elapsed >= wait3 (8 s, CR-004)"},
    {"from": "any", "to": "PAUSED", "guard": "STOP and not shutting", "trace": ["D-02", "D-03"]},
    {"from": "PAUSED", "to": "resume", "guard": "START (freeze remaining delay)", "trace": ["D-03", "D-04"]},
    {"from": "any", "to": "SHUTTING", "guard": "SHUT (precedence SHUT>STOP>START)", "trace": ["D-01", "D-05"]},
    {"from": "SHUTTING", "to": "IDLE", "guard": "h1<=h1Low and h2<=h2Low", "trace": ["D-06", "D-07"]}
  ],
  "requirements": [
    {"id": "D-01", "text": "Command precedence SHUT > STOP > START"},
    {"id": "D-02", "text": "STOP closes all valves and stores interrupted state"},
    {"id": "D-03", "text": "STOP during a delay freezes remaining delay; START resumes it"},
    {"id": "D-04", "text": "START while auto sequence already running is ignored"},
    {"id": "D-05", "text": "START/STOP during active SHUT are ignored"},
    {"id": "D-06", "text": "SHUT complete only when LT-101 and LT-102 both at/below low"},
    {"id": "D-07", "text": "After shutdown, all valves closed, context reset to IDLE"},
    {"id": "D-08", "text": "V1 and V2 must never be commanded open together"},
    {"id": "D-09", "text": "V2 and V3 not open together in auto; SHUT is the only exception"}
  ],
  "parameters": {
    "A1_m2": 1.20, "A2_m2": 1.40, "h0_m": 0.05,
    "h1High_m": 0.80, "h1Low_m": 0.05, "h2Low_m": 0.05,
    "qFill_m3s": 0.0060, "qTransfer_m3s": 0.0045, "qDrain_m3s": 0.0050,
    "wait1_s": 10, "wait2_s": 12, "wait3_s": 8
